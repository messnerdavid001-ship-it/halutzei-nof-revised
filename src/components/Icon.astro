---
// One consistent thin-line icon set (24x24, inline SVG). Brand marks are filled.
interface Props { name: string; size?: number; class?: string }
const { name, size = 28, class: cls } = Astro.props;
const c = (x: number, y: number, r: number) => `M${x - r} ${y}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`;
const LINE: Record<string, string> = {
  zion: 'M12 3 20 17H4zM12 21 4 7h16z',
  family: c(8, 7, 2.4) + c(16, 7, 2.4) + c(12, 14.2, 1.9) + 'M3.5 20c0-3 2.2-5 4.5-5M20.5 20c0-3-2.2-5-4.5-5M9 21c0-2 1.3-3.4 3-3.4s3 1.4 3 3.4',
  education: 'M2.5 5.5c3.2-1 6-.5 9.5 1.5 3.500-2 6.300-2.500 9.500-1.500V19c-3.200-1-6-.5-9.500 1.500C8.500 18.500 5.700 18 2.500 19zM12 7v13.500',
  national: 'M12 3 20 6v6c0 5-3.500 8-8 9-4.500-1-8-4-8-9V6zM8.500 12l2.500 2.500 4.500-5',
  service: 'M12 3l2.700 5.600 6.100.9-4.400 4.300 1 6.100L12 17l-5.400 2.900 1-6.100L3.200 9.500l6.100-.9z',
  mutual: c(9, 12, 5) + c(15, 12, 5),
  work: 'M12 21v-9M12 13C12 8.500 9 6 4.500 6 4.500 10.500 7.500 13 12 13zM12 15c0-3.500 2.500-6 7-6 0 3.500-2.500 6-7 6z',
  independence: c(12, 5, 2.2) + 'M12 8v7M5.500 10 12 8l6.500 2M8.500 21l3.500-6 3.500 6',
  unity: 'M12 20S4 15.500 4 10a4.500 4.500 0 0 1 8-2.800A4.500 4.500 0 0 1 20 10c0 5.500-8 10-8 10z',
  form: 'M6 3h8l5 5v13H6zM14 3v5h5M9 13h7M9 17h7',
  chat: 'M4 5h16v11h-9.500L6 20v-4H4z',
  people: c(9, 8, 3) + c(17, 9, 2.4) + 'M3 20c0-3.500 2.700-6 6-6s6 2.500 6 6M16 14c3 0 5 2 5 5',
  path: 'M4 12h14M13 6l6 6-6 6',
  sunrise: 'M3 19h18M6 19a6 6 0 0 1 12 0M12 5v2.500M5 9l1.800 1.800M19 9l-1.800 1.800',
  house: 'M3.500 11 12 4l8.500 7M5.500 9.500V20h13V9.500M10 20v-5.500h4V20',
  phone: 'M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z',
  mail: 'M3 6h18v12H3zM3 7l9 7 9-7',
};
const FILL: Record<string, string> = {
  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.2-2.2a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
  facebook: 'M13.5 21v-8h2.7l.4-3.2h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.5c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.3H7.7V13h2.7v8h3.1z',
  whatsapp: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.200zm4.5-6.1c-.2-.1-1.500-.7-1.700-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.200-.3.200-.5.100a6.700 6.700 0 0 1-3.300-2.900c-.2-.4.200-.4.700-1.300.1-.2 0-.3 0-.5l-.8-1.800c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.300 3 3 0 0 0-.9 2.200 5.200 5.200 0 0 0 1.100 2.800 11.900 11.900 0 0 0 4.600 4.100c1.700.7 2.300.8 3.200.7.600-.1 1.500-.6 1.700-1.200.2-.6.2-1.100.2-1.200-.1-.1-.3-.2-.5-.3z',
};
const filled = name in FILL;
const d = filled ? FILL[name] : LINE[name] || LINE.path;
---
{filled ? (
  <svg class={cls} viewBox="0 0 24 24" width={size} height={size} fill="currentColor" fill-rule="evenodd" aria-hidden="true" focusable="false"><path d={d} /></svg>
) : (
  <svg class={cls} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={d} /></svg>
)}
