---
import ContactDetails from './ContactDetails.astro';
import Pic from './Pic.astro';
import { getUi, logoSrc, pagePath, settings, todoMark, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getUi(lang);
const year = new Date().getFullYear();
const legal = settings.legalName[lang];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href={pagePath('index', lang)} aria-label={t.siteName}><Pic src={logoSrc(lang)} alt={t.logoAlt} sizes="160px" /></a>
      <p class="footer-tagline">{t.footer.tagline}</p>
    </div>
    <nav class="footer-col" aria-label={t.footer.pagesTitle}>
      <h2 class="footer-title">{t.footer.pagesTitle}</h2>
      <ul class="footer-links">
        <li><a href={pagePath('contact', lang) + '#faq'}>{t.footer.faq}</a></li>
        <li><a href={pagePath('accessibility', lang)}>{t.footer.accessibility}</a></li>
        <li><a href={pagePath('privacy', lang)}>{t.footer.privacy}</a></li>
      </ul>
    </nav>
    <div class="footer-col">
      <h2 class="footer-title">{t.footer.contactTitle}</h2>
      <ContactDetails lang={lang} />
    </div>
    <p class="copyright">
      {t.footer.copyright.replace('{year}', String(year))}
      {legal ? ` ${legal}` : ''}
      <Fragment set:html={legal ? '' : todoMark('legal', lang)} />
    </p>
  </div>
</footer>
