---
interface Props { href: string; variant?: 'gold' | 'navy' | 'ghost' | 'ghost-dark' | 'wa'; class?: string; external?: boolean }
const { href, variant = 'gold', class: cls, external = false } = Astro.props;
---
<a class:list={['btn', `btn--${variant}`, cls]} href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}><slot /></a>
