---
import { getUi, settings, contactValue, todoMark, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getUi(lang);
const kinds = ['phone', 'email', 'instagram', 'facebook'] as const;
const items = kinds
  .map((k) => {
    const v = contactValue(k);
    const digits = (v || '').replace(/[^\d]/g, '');
    const intl = digits.startsWith('0') ? '972' + digits.slice(1) : digits;
    const href =
      k === 'phone' ? `tel:${digits}` :
      k === 'email' ? `mailto:${v}` : v;
    const wa = k === 'phone' && v ? `https://wa.me/${intl}` : '';
    return { k, v, href, label: (t.footer as any)[k], placeholder: (t.placeholders as any)[k], mark: todoMark(k, lang), wa };
  })
  .filter((i) => i.v || settings.showTodo);
const icon = {
  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.2-2.2a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
  facebook: 'M13.5 21v-8h2.7l.4-3.2h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.5c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.3H7.7V13h2.7v8h3.1z',
} as Record<string, string>;
---
<ul class="cd">
  {items.map((i) => (
    <li>
      {i.v ? (
        <a href={i.href} {...(i.k === 'instagram' || i.k === 'facebook' ? { target: '_blank', rel: 'noopener' } : {})}>
          {icon[i.k] && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor" fill-rule="evenodd"><path d={icon[i.k]} /></svg>}
          <span>{i.label}{i.k === 'instagram' || i.k === 'facebook' ? '' : ': '}{i.k === 'instagram' || i.k === 'facebook' ? '' : <bdi dir="ltr">{i.v}</bdi>}</span>
        </a>
      ) : (
        <span class="cd-ph">{i.label}: <bdi>{i.placeholder}</bdi></span>
      )}
      {i.wa && (
        <a class="cd-wa" href={i.wa} target="_blank" rel="noopener" aria-label={`WhatsApp`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.200zm4.5-6.1c-.2-.1-1.500-.7-1.700-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.200-.3.200-.5.100a6.700 6.700 0 0 1-3.300-2.900c-.2-.4.200-.4.700-1.300.1-.2 0-.3 0-.5l-.8-1.800c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.300 3 3 0 0 0-.9 2.200 5.200 5.200 0 0 0 1.100 2.800 11.900 11.900 0 0 0 4.600 4.100c1.700.7 2.300.8 3.200.7.600-.1 1.500-.6 1.700-1.200.2-.6.2-1.100.2-1.200-.1-.1-.3-.2-.5-.3z"/></svg>
          <span class="sr-only">WhatsApp</span>
        </a>
      )}
      <Fragment set:html={i.v ? '' : i.mark} />
    </li>
  ))}
</ul>
