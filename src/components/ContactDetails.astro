---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { getUi, settings, contactValue, todoMark, phoneDisplay, waLink, type Lang } from '../lib/site';
interface Props { lang: Lang; variant?: 'footer' | 'cards' }
const { lang, variant = 'footer' } = Astro.props;
const t = getUi(lang);
const isPhoneKind = (k: string) => k === 'phone' || k === 'phone2';
const kinds = ['phone', 'phone2', 'email', 'instagram', 'facebook', 'tiktok'] as const;
const items = kinds
  .map((k) => {
    const v = contactValue(k);
    const digits = (v || '').replace(/[^\d]/g, '');
    const isPhone = k === 'phone' || k === 'phone2';
    const shown = isPhone ? phoneDisplay(v) : v;
    const href = isPhone ? `tel:${digits}` : k === 'email' ? `mailto:${v}` : v;
    const person = isPhone ? ((settings as any)[k + 'Name']?.[lang] || '') : '';
    return { k, v, shown, person, href, label: (t.footer as any)[k], placeholder: (t.placeholders as any)[k], mark: todoMark(k, lang), social: k === 'instagram' || k === 'facebook' || k === 'tiktok' };
  })
  .filter((i) => i.v || (settings.showTodo && i.k !== 'phone2'));
const main = items.filter((i) => !i.social);
const social = items.filter((i) => i.social);
---
{variant === 'cards' ? (
  <ul class="contact-cards">
    {items.map((i) => (
      <li>
        {isPhoneKind(i.k) && i.v && (
          <Button href={waLink(i.v)} variant="wa" external class="btn--big cc-wa"><Icon name="whatsapp" size={26} />{t.whatsapp.button}</Button>
        )}
        {i.v ? (
          <a class="contact-card" href={i.href} {...(i.social ? { target: '_blank', rel: 'noopener' } : {})}>
            <Icon name={i.k === 'phone' || i.k === 'phone2' ? 'phone' : i.k === 'email' ? 'mail' : i.k} size={30} />
            <span class="cc-label">{i.label}</span>
            {i.person && <span class="cc-name">{i.person}</span>}
            {!i.social && <bdi class="cc-value" dir="ltr">{i.shown}</bdi>}
          </a>
        ) : (
          <span class="contact-card contact-card--empty"><span class="cc-label">{i.label}</span><bdi>{i.placeholder}</bdi></span>
        )}
        <Fragment set:html={i.v ? '' : i.mark} />
      </li>
    ))}
  </ul>
) : (
  <div class="cd-wrap">
    <ul class="cd">
      {main.map((i) => (
        <li>
          {i.v ? (
            <a href={i.href}>
              <Icon name={i.k === 'phone' || i.k === 'phone2' ? 'phone' : 'mail'} size={20} />
              <span>{i.label}{i.person && ` (${i.person})`}: <bdi dir="ltr">{i.shown}</bdi></span>
            </a>
          ) : (
            <span class="cd-ph">{i.label}: <bdi>{i.placeholder}</bdi></span>
          )}
          {isPhoneKind(i.k) && i.v && (
            <a class="cd-wa" href={waLink(i.v)} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /><span class="sr-only">{t.whatsapp.title}</span></a>
          )}
          <Fragment set:html={i.v ? '' : i.mark} />
        </li>
      ))}
    </ul>
    <ul class="social">
      {social.map((i) => (
        <li>
          {i.v ? (
            <a href={i.href} target="_blank" rel="noopener" aria-label={i.label} title={i.label}><Icon name={i.k} size={22} /></a>
          ) : (
            <span class="cd-ph">{i.label}: <bdi>{i.placeholder}</bdi></span>
          )}
          <Fragment set:html={i.v ? '' : i.mark} />
        </li>
      ))}
    </ul>
  </div>
)}
