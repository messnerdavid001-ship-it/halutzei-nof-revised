---
import Icon from './Icon.astro';
import { getUi, settings, contactValue, todoMark, phoneDisplay, waLink, type Lang } from '../lib/site';
interface Props { lang: Lang; variant?: 'footer' | 'cards' }
const { lang, variant = 'footer' } = Astro.props;
const t = getUi(lang);
const kinds = ['phone', 'email', 'instagram', 'facebook'] as const;
const items = kinds
  .map((k) => {
    const v = contactValue(k);
    const digits = (v || '').replace(/[^\d]/g, '');
    const shown = k === 'phone' ? phoneDisplay() : v;
    const href = k === 'phone' ? `tel:${digits}` : k === 'email' ? `mailto:${v}` : v;
    return { k, v, shown, href, label: (t.footer as any)[k], placeholder: (t.placeholders as any)[k], mark: todoMark(k, lang), social: k === 'instagram' || k === 'facebook' };
  })
  .filter((i) => i.v || settings.showTodo);
const main = items.filter((i) => !i.social);
const social = items.filter((i) => i.social);
const wa = waLink();
---
{variant === 'cards' ? (
  <ul class="contact-cards">
    {items.map((i) => (
      <li>
        {i.v ? (
          <a class="contact-card" href={i.href} {...(i.social ? { target: '_blank', rel: 'noopener' } : {})}>
            <Icon name={i.k === 'phone' ? 'phone' : i.k === 'email' ? 'mail' : i.k} size={30} />
            <span class="cc-label">{i.label}</span>
            {!i.social && <bdi class="cc-value" dir="ltr">{i.shown}</bdi>}
          </a>
        ) : (
          <span class="contact-card contact-card--empty"><span class="cc-label">{i.label}</span><bdi>{i.placeholder}</bdi></span>
        )}
        <Fragment set:html={i.v ? '' : i.mark} />
      </li>
    ))}
  </ul>
) : (
  <div class="cd-wrap">
    <ul class="cd">
      {main.map((i) => (
        <li>
          {i.v ? (
            <a href={i.href}>
              <Icon name={i.k === 'phone' ? 'phone' : 'mail'} size={20} />
              <span>{i.label}: <bdi dir="ltr">{i.shown}</bdi></span>
            </a>
          ) : (
            <span class="cd-ph">{i.label}: <bdi>{i.placeholder}</bdi></span>
          )}
          {i.k === 'phone' && i.v && wa && (
            <a class="cd-wa" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /><span class="sr-only">{t.whatsapp.title}</span></a>
          )}
          <Fragment set:html={i.v ? '' : i.mark} />
        </li>
      ))}
    </ul>
    <ul class="social">
      {social.map((i) => (
        <li>
          {i.v ? (
            <a href={i.href} target="_blank" rel="noopener" aria-label={i.label} title={i.label}><Icon name={i.k} size={22} /></a>
          ) : (
            <span class="cd-ph">{i.label}: <bdi>{i.placeholder}</bdi></span>
          )}
          <Fragment set:html={i.v ? '' : i.mark} />
        </li>
      ))}
    </ul>
  </div>
)}
