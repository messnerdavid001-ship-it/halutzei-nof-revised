---
interface Props { tone?: 'navy' | 'white'; title?: string; id?: string; narrow?: boolean }
const { tone = 'white', title, id, narrow = false } = Astro.props;
---
<section class:list={['section', `section--${tone}`]} id={id}>
  <div class:list={['container', { 'container--narrow': narrow }]}>
    {title && <h2>{title}</h2>}
    <slot />
  </div>
</section>
