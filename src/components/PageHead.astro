---
import TextBlock from './TextBlock.astro';
import type { Lang } from '../lib/site';
interface Props { title: string; intro?: string; lang: Lang }
const { title, intro, lang } = Astro.props;
---
<header class="panel panel--navy page-head" data-reveal>
  <h1>{title}</h1>
  {intro && <TextBlock text={intro} lang={lang} class="lead" />}
</header>
