---
import { getUi, type Lang } from '../lib/site';
interface Props { lang: Lang }
const t = getUi(Astro.props.lang).a11y;
---
<div class="a11y" data-a11y>
  <button type="button" class="a11y-btn" aria-expanded="false" aria-controls="a11y-panel" aria-label={t.button} title={t.button} data-a11y-btn>
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><circle cx="12" cy="4.2" r="2.2"/><path d="M4 8.5h16v2.2h-6.3v3.1l2.6 6.5-2.1.8L12 15.4l-2.2 5.7-2.1-.8 2.6-6.5v-3.1H4z"/></svg>
  </button>
  <div id="a11y-panel" class="a11y-panel" role="dialog" aria-label={t.title} hidden data-a11y-panel>
    <p class="a11y-title">{t.title}</p>
    <button type="button" data-a11y-act="bigger">{t.bigger}</button>
    <button type="button" data-a11y-act="smaller">{t.smaller}</button>
    <button type="button" data-a11y-act="contrast" aria-pressed="false">{t.contrast}</button>
    <button type="button" data-a11y-act="underline" aria-pressed="false">{t.underline}</button>
    <button type="button" data-a11y-act="reset">{t.reset}</button>
    <button type="button" class="a11y-close" data-a11y-act="close">{t.close}</button>
  </div>
</div>
