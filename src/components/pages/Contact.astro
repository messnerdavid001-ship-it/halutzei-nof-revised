---
import BandHero from '../BandHero.astro';
import Section from '../Section.astro';
import TextBlock from '../TextBlock.astro';
import ContactForm from '../ContactForm.astro';
import { getPage, getUi, type Lang } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('contact', lang);
const t = getUi(lang);
---
<BandHero title={p.title} />
<Section tone="white" narrow>
  <TextBlock text={p.intro} lang={lang} />
  <h2 class="visually-sub">{t.form.title}</h2>
  <ContactForm lang={lang} />
</Section>
