---
import Panel from '../Panel.astro';
import Icon from '../Icon.astro';
import PageHead from '../PageHead.astro';
import ContactDetails from '../ContactDetails.astro';
import Form from '../Form.astro';
import TextBlock from '../TextBlock.astro';
import { getPage, getUi, inline, type Lang } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('contact', lang);
const t = getUi(lang);
---
<PageHead title={p.title} intro={p.intro} lang={lang} />
<Panel tone="navy" class="panel--contact">
  <ContactDetails lang={lang} variant="cards" />
</Panel>
<Panel tone="navy" title={p.stepsTitle} id="how-it-works">
  <ol class="steps">
    {p.steps.map((s: any, i: number) => (
      <li class="step">
        <span class="step-icon"><Icon name={s.icon} size={34} /><span class="step-num" aria-hidden="true">{i + 1}</span></span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
  <p class="steps-note" set:html={inline(p.stepsNote, lang)} />
</Panel>
<Panel tone="navy" title={p.faqTitle} id="faq" class="panel--faq">
  <div class="faq">
    {p.faq.map((it: any) => (
      <details class="faq-item">
        <summary><span>{it.q}</span></summary>
        <div class="faq-a"><p set:html={inline(it.a, lang)} /></div>
      </details>
    ))}
  </div>
</Panel>
<Panel tone="navy" title={p.formTitle} id="join-form" class="panel--form">
  <TextBlock text={p.joinIntro} lang={lang} class="form-note" />
  <TextBlock text={p.formNote} lang={lang} class="form-note" />
  <Form lang={lang} kind="join" />
</Panel>
