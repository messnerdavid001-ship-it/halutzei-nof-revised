---
import Panel from '../Panel.astro';
import PageHead from '../PageHead.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import ContactDetails from '../ContactDetails.astro';
import Form from '../Form.astro';
import { getPage, getUi, waLink, type Lang } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('contact', lang);
const t = getUi(lang);
const wa = waLink();
---
<PageHead title={p.title} intro={p.intro} lang={lang} />
<Panel tone="navy" class="panel--contact">
  {wa && <div class="btn-row btn-row--big"><Button href={wa} variant="wa" external class="btn--big"><Icon name="whatsapp" size={26} />{t.whatsapp.button}</Button></div>}
  <ContactDetails lang={lang} variant="cards" />
</Panel>
<Panel tone="light" title={t.form.contactTitle} id="contact-form" class="panel--form">
  <Form lang={lang} kind="contact" />
</Panel>
