---
import PhotoHero from '../PhotoHero.astro';
import Section from '../Section.astro';
import TextBlock from '../TextBlock.astro';
import ListBlock from '../ListBlock.astro';
import Button from '../Button.astro';
import Pic from '../Pic.astro';
import { getPage, getUi, getEvents, formatDate, pagePath, settings, type Lang } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('community', lang);
const t = getUi(lang);
const events = getEvents(lang);
---
<PhotoHero src={settings.communityBackground} alt={p.backgroundAlt} variant="community" lang={lang}>
  <h1 class="hero-title">{p.title}</h1>
</PhotoHero>
<Section tone="navy" title={p.fitTitle}>
  <TextBlock text={p.fit} lang={lang} />
  <h3 class="subhead">{p.audienceTitle}</h3>
  <ListBlock items={p.audience} lang={lang} />
</Section>
<Section tone="white" title={p.processTitle}>
  <TextBlock text={p.process} lang={lang} />
</Section>
<Section tone="navy" title={p.commitmentTitle}>
  <TextBlock text={p.commitment} lang={lang} />
</Section>
<Section tone="white" title={p.eventsTitle} id="events">
  {events.length === 0 ? (
    <p class="empty">{p.eventsEmpty}</p>
  ) : (
    <ul class="events">
      {events.map((e) => (
        <li class="event">
          {e.photo && <div class="event-photo"><Pic src={e.photo} alt={e.photoAlt} sizes="(min-width: 768px) 360px, 90vw" /></div>}
          <h3>{e.title}</h3>
          <p class="event-meta">
            {e.date && <span>{t.events.date}: {formatDate(e.date, lang)}</span>}
            {e.place && <span>{t.events.place}: {e.place}</span>}
          </p>
          {e.description && <p>{e.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Section>
<Section tone="navy" title={p.ctaTitle}>
  <TextBlock text={p.ctaText} lang={lang} />
  <div class="btn-row"><Button href={`${pagePath('contact', lang)}?type=join`} variant="light">{t.btnJoinCommunity}</Button></div>
</Section>
