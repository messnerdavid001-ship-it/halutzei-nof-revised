---
import Panel from '../Panel.astro';
import PageHead from '../PageHead.astro';
import TextBlock from '../TextBlock.astro';
import { getPage, type Lang } from '../../lib/site';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const p = getPage(slug, lang);
---
<PageHead title={p.title} lang={lang} />
<Panel tone="light"><TextBlock text={p.text} lang={lang} class="prose--legal" /></Panel>
