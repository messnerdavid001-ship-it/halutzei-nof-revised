---
// Vision & Values and Community & Education share one layout:
// header panel with a one-line summary, then a panel per group of short cards, then the closing call to action.
import Panel from '../Panel.astro';
import PageHead from '../PageHead.astro';
import Icon from '../Icon.astro';
import TextBlock from '../TextBlock.astro';
import CtaPanel from '../CtaPanel.astro';
import { getPage, inline, type Lang } from '../../lib/site';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const p = getPage(slug, lang);
---
<PageHead title={p.title} intro={p.intro} lang={lang} />
{p.groups.map((g: any) => (
  <Panel tone="navy" title={g.title} id={g.id}>
    {g.intro && <TextBlock text={g.intro} lang={lang} class="group-intro" />}
    {g.cards.length > 0 && <ul class="value-cards">
      {g.cards.map((c: any) => (
        <li class="value-card">
          <Icon name={c.icon} size={44} class="value-icon" />
          <h3 set:html={inline(c.title, lang)} />
          <p set:html={inline(c.text, lang)} />
        </li>
      ))}
    </ul>}
  </Panel>
))}
<CtaPanel lang={lang} title={p.ctaTitle} text={p.ctaText} />
