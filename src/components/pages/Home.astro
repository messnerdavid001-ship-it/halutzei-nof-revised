---
import Panel from '../Panel.astro';
import Button from '../Button.astro';
import Pic from '../Pic.astro';
import Icon from '../Icon.astro';
import TextBlock from '../TextBlock.astro';
import CtaPanel from '../CtaPanel.astro';
import { getPage, getUi, pagePath, todoMark, type Lang } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('index', lang);
const v = getPage('vision', lang).groups.find((g: any) => g.id === 'values');
const t = getUi(lang);
const photos = (p.photos || []).filter((x: any) => x.image);
---
<section class="hero">
  <div class="hero-inner">
    <Pic class="hero-logo" src="/photos/logo.png" alt={t.logoAlt} sizes="(min-width: 768px) 400px, 62vw" loading="eager" fetchpriority="high" />
    <div class="hero-copy">
      <h1 class="headline">{p.headline}</h1>
      <p class="slogan">{p.tagline}</p>
      <div class="btn-row"><Button href={pagePath('join', lang)}>{t.btnJoin}</Button></div>
    </div>
  </div>
  <div class="hero-foot">
    <p class="hero-marker" set:html={todoMark('photo', lang)} />
    <a class="scroll-hint" href="#content" aria-label={t.scrollDown}><span aria-hidden="true"></span></a>
  </div>
</section>

<Panel tone="navy" title={p.introTitle} id="content">
  <TextBlock text={p.intro} lang={lang} />
</Panel>

<Panel tone="navy" title={p.audienceTitle} id="audience">
  <TextBlock text={p.audienceText} lang={lang} />
</Panel>

<Panel tone="navy" title={p.valuesTitle} id="values-teaser">
  <TextBlock text={p.valuesText} lang={lang} />
  <ul class="icon-strip">
    {v.cards.map((x: any) => (
      <li><a href={pagePath('vision', lang) + '#values'}><Icon name={x.icon} size={34} /><span>{x.title}</span></a></li>
    ))}
  </ul>
</Panel>

{photos.length > 0 && (
  <Panel tone="navy" class="panel--photos">
    <div class="photo-slots">
      {photos.slice(0, 2).map((ph: any) => (
        <figure class="slot"><Pic src={ph.image} alt={ph.alt} sizes="(min-width: 768px) 460px, 90vw" /></figure>
      ))}
    </div>
  </Panel>
)}

<CtaPanel lang={lang} title={p.ctaTitle} text={p.ctaText} />
