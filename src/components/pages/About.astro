---
import Panel from '../Panel.astro';
import PageHead from '../PageHead.astro';
import TextBlock from '../TextBlock.astro';
import Pic from '../Pic.astro';
import CtaPanel from '../CtaPanel.astro';
import { getPage, todoMark, inline, type Lang } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('about', lang);
---
<PageHead title={p.title} intro={p.intro} lang={lang} />
<Panel tone="navy" title={p.identityTitle} class="panel--centered"><TextBlock text={p.identity} lang={lang} /></Panel>
<CtaPanel lang={lang} title={getPage('home', lang).ctaTitle} text={getPage('home', lang).ctaText} />

<section class="panel panel--navy memorial-panel" id="memorial" aria-labelledby="memorial-title" data-reveal>
  <hr class="divider" />
  <h2 id="memorial-title" class="memorial-title">{p.memorialTitle}</h2>
  <TextBlock text={p.memorialIntro} lang={lang} />
  <p class="memorial-todo" set:html={todoMark('memorial', lang)} />
  <ul class="memorials">
    {p.memorials.map((m: any) => (
      <li class="memorial">
        <div class="memorial-photo">
          {m.photo ? <Pic src={m.photo} alt={m.photoAlt || m.name} sizes="220px" /> : <span aria-hidden="true"></span>}
        </div>
        <h3 set:html={inline(m.name, lang)} />
        {m.text && <p set:html={inline(m.text, lang)} />}
        <p class="memorial-tag">{p.memorialTag}</p>
      </li>
    ))}
  </ul>
</section>
