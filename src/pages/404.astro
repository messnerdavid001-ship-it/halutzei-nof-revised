---
import BaseLayout from '../components/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import PageHead from '../components/PageHead.astro';
import Button from '../components/Button.astro';
import { getUi, pagePath, bgFor } from '../lib/site';
const t = getUi('he');
const e = getUi('en');
---
<BaseLayout lang="he" slug="404" title={t.notFound.title} noindex bg={{ ...bgFor('404'), alt: '' }}>
  <PageHead title={t.notFound.title} lang="he" />
  <Panel tone="navy">
    <p class="empty">{t.notFound.text}</p>
    <div class="btn-row"><Button href={pagePath('index', 'he')}>{t.notFound.back}</Button></div>
    <p class="empty" lang="en" dir="ltr">{e.notFound.text} <a href={pagePath('index', 'en')}>{e.notFound.back}</a></p>
  </Panel>
</BaseLayout>
