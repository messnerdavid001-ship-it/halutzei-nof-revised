---
import PageView from '../components/PageView.astro';
import { SLUGS, settings } from '../lib/site';

export function getStaticPaths() {
  return SLUGS.filter((s) => s !== 'donate' || settings.donateEnabled).map((s) => ({
    params: { slug: s === 'index' ? undefined : s },
    props: { slug: s },
  }));
}
const { slug } = Astro.props;
---
<PageView lang="he" slug={slug} />
