---
import BaseLayout from '../../components/BaseLayout.astro';
import Home from '../../components/pages/Home.astro';
import About from '../../components/pages/About.astro';
import Vision from '../../components/pages/Vision.astro';
import Community from '../../components/pages/Community.astro';
import Partners from '../../components/pages/Partners.astro';
import Contact from '../../components/pages/Contact.astro';
import Legal from '../../components/pages/Legal.astro';
import { SLUGS, getPage, settings } from '../../lib/site';

export function getStaticPaths() {
  return SLUGS.filter((s) => s !== 'donate' || settings.donateEnabled).map((s) => ({
    params: { slug: s === 'index' ? undefined : s },
    props: { slug: s },
  }));
}
const lang = 'en';
const { slug } = Astro.props;
const p = getPage(slug, lang);
const views: Record<string, any> = { index: Home, about: About, vision: Vision, community: Community, partners: Partners, contact: Contact };
const View = views[slug];
---
<BaseLayout lang={lang} slug={slug} title={p.seoTitle} description={p.seoDescription} noindex={slug === 'donate'}>
  {View ? <View lang={lang} /> : <Legal lang={lang} slug={slug} />}
</BaseLayout>
